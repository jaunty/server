# Run as 1000:1000 in container
UID=1000
GID=1000

# Set the initial and max heap size to 6GB. Leave ~2GB available
# for JVM overhead and the OS.
MEMORY="6G"

TZ="America/New_York"
LOG_LEVEL="info"

# Use MeowIce's optimization flags for the JVM, etc.
# https://github.com/MeowIce/meowice-flags
USE_MEOWICE_FLAGS=true

# Set the config destination to /data so we can copy over server config files
# like bukkit.yml, etc.
COPY_CONFIG_DEST="/data"

MODRINTH_PROJECTS="@/config/modrinth.txt"

ENABLE_RCON=true
RCON_PASSWORD_FILE="/run/secrets/rcon_password"
